{
  "name": "controller-mouse",
  "private": true,
  "version": "1.0.1",
  "description": "Use an Xbox/PlayStation-style gamepad as a system-wide mouse on Windows.",
  "author": "asherwin86",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --publish=never",
    "release:win": "electron-builder --win --publish=always"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "au.com.feesynergy.controllermouse",
    "productName": "Controller Mouse",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "cursor-daemon.ps1",
      "renderer/**",
      "assets/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "asherwin86",
      "repo": "owen-controller-mouse-app",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
